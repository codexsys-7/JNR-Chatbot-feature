# ─────────────────────────────────────────────────────────────
# JRN Events AI Chatbot — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real OpenAI API key below
# 3. NEVER commit the .env file — it is listed in .gitignore
# ─────────────────────────────────────────────────────────────

# OpenAI API Key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Port for the local AI proxy server (default: 3001)
PORT=3001
